# ---------------------------------------------------------------------------
# Student 3 - AI Agent / Decision Engine - environment variables
# Copy to `.env` and fill in. The app runs WITHOUT any key (mock mode).
# ---------------------------------------------------------------------------

# --- LLM provider (optional) ------------------------------------------------
# Any OpenAI-compatible endpoint. Leave blank to run in deterministic mock mode.
LLM_API_KEY=
# Alias also accepted: OPENAI_API_KEY

# Model name (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Custom base URL for OpenAI-compatible gateways (Azure, Groq, Together, vLLM, Ollama)
# e.g. https://api.groq.com/openai/v1   or   http://localhost:11434/v1
LLM_BASE_URL=

# Force deterministic mock mode even when a key is present (1/true/yes)
STUDENT3_FORCE_MOCK=1

# --- App --------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8000
