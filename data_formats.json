{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Student 3 - AI Agent / Decision Engine contracts",
  "version": "1.0.0",
  "description": "Frozen interfaces between Student 2 (complaint intelligence), Student 1 (backend) and Student 4 (frontend). Do not change field names without updating this file.",
  "inbound": {
    "AgentRequest": {
      "type": "object",
      "required": ["complaint_id", "clean_text", "issue_type"],
      "properties": {
        "complaint_id": { "type": "string", "example": "C001" },
        "clean_text": { "type": "string", "example": "my headphones arrived damaged" },
        "issue_type": { "type": "string", "example": "Damaged Product" },
        "sentiment": { "type": "string", "example": "Negative" },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "cluster": { "type": "string", "example": "Damaged Products" },
        "customer_id": { "type": "string", "nullable": true, "example": "U101" },
        "order_id": { "type": "string", "nullable": true, "example": "O501" }
      }
    }
  },
  "upstream_context": {
    "CustomerRecord": {
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "membership_tier": { "type": "string" },
        "is_high_risk": { "type": "boolean" },
        "previous_complaints": { "type": "integer" }
      }
    },
    "OrderRecord": {
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "product": { "type": "string" },
        "status": { "type": "string", "enum": ["Processing", "Shipped", "In Transit", "Delivered", "Cancelled", "Returned"] },
        "delivery_date": { "type": "string", "nullable": true, "format": "date" },
        "expected_delivery": { "type": "string", "nullable": true, "format": "date" },
        "return_window_open": { "type": "boolean" },
        "payment_status": { "type": "string", "enum": ["Paid", "Pending", "Failed", "Refunded"] },
        "amount_paid": { "type": "number" },
        "refund_confirmed": { "type": "boolean" },
        "refund_amount": { "type": "number" },
        "tracking_status": { "type": "string", "nullable": true },
        "carrier": { "type": "string", "nullable": true },
        "data_conflict": { "type": "boolean" }
      }
    }
  },
  "outbound": {
    "AgentResponse": {
      "type": "object",
      "required": [
        "complaint_id",
        "summary",
        "action",
        "reason",
        "customer_message",
        "escalate",
        "missing_information"
      ],
      "properties": {
        "complaint_id": { "type": "string" },
        "summary": { "type": "string", "description": "Internal summary for staff/Student 4." },
        "action": { "type": "string", "description": "Deterministic recommended action." },
        "reason": { "type": "string", "description": "Policy-based explanation." },
        "customer_message": { "type": "string", "description": "Customer-facing text, guardrail checked." },
        "escalate": { "type": "boolean" },
        "missing_information": { "type": "array", "items": { "type": "string" } },
        "escalate_reason": { "type": "string", "nullable": true },
        "guardrail_flags": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string", "nullable": true },
        "issue_type": { "type": "string", "nullable": true },
        "used_llm": { "type": "boolean" },
        "llm_provider": { "type": "string", "nullable": true },
        "policy_version": { "type": "string", "nullable": true }
      }
    }
  },
  "internal_only": {
    "note": "escalate_reason, guardrail_flags, policy_version and the raw LLM output are INTERNAL. Student 4 must never render them in the customer UI."
  }
}
